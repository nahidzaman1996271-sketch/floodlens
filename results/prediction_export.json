  "sample_alerts": [
    {
      "building_id": "B0002",
      "risk_level": "CRITICAL",
      "message": "There is critical flooding risk near your location. Please leave immediately for the Char Bandar Primary School Shelter at a distance of approximately 2 km away. Move children, elderly, pregnant women, and disabled individuals to safety first. Pack essential items such as ID cards, prescription medicines, drinking water, dry food, torches, charged phones, and cash in sealed plastic bags. Access road Village Access Road 1 will become impassable soon; use an alternative route if necessary. Stay calm and follow the guidance provided.",
      "source": "ollama_local",
      "message_bn": "\u09b8\u09cd\u09a5\u09be\u09af\u09bc\u09c0 \u099c\u09b2\u09ac\u09be\u09b9\u09be\u09a6\u09c1\u09b0\u09c7\u09b0 \u0995\u09cd\u09b7\u09a4\u09bf \u09b8\u09ae\u09cd\u09ad\u09ac \u0986\u099b\u09c7 \u09a4\u09a5\u09be \u09aa\u09b0\u09bf\u09ac\u09c7\u09b6\u099f\u09bf \u09a8\u09bf\u099a\u09c7\u0964 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7, \u098f\u0996\u09a8\u0987 \u09af\u09be\u0993\u09af\u09bc\u09be\u09b0 \u099c\u09a8\u09cd\u09af Char Bandar Primary School Shelter \u09a5\u09c7\u0995\u09c7 2 \u0995\u09bf\u09ae\u09bf \u09a6\u09c2\u0930\u09c7 \u099b\u09cb\u099f\u09ac\u09b8\u09a4 \u09aa\u09a3\u09cd\u09a1\u09bf\u09a4 \u09b6\u09bf\u0995\u09cd\u09b7\u09be \u09b8\u09b9\u0995\u09be\u09b0\u09c0 \u09ac\u09be\u09a8\u09be\u09b2\u09bf\u09b0 \u0989\u09aa\u09b0 \u09af\u09be\u0993\u09af\u09bc\u09be\u09b0 \u0986\u09b2\u09be\u09b9\u09cd\u09ae\u09a6\u0964 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7, \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09b6\u09bf\u09b6\u09c1, \u09ac\u09be\u09a1\u09bc\u09bf\u09ac\u09be\u09a8\u09c0, \u0997\u09cd\u09b0\u09be\u09ae\u0995\u09a5\u09be\u09af\u09bc \u099c\u09ae\u09be \u09a5\u09be\u0995\u09be \u0986\u09b8\u09b2\u09be \u09b8\u09a8\u09cd\u09a4\u09be\u09a8, \u098f\u09ac\u0982 \u09aa\u09b0\u09bf\u09a3\u09a4 \u09ae\u09c7\u09af\u09bc\u09c7\u09a6\u09c7\u09b0 \u09ac\u09be \u0985\u09aa\u09b0\u09be\u09a7\u09c0 \u09b2\u09cb\u0995\u09a6\u09c7\u09b0 \u09af\u09be\u0993\u09af\u09bc\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u0997\u09c7\u0987 \u09b8\u09ae\u09b8\u09cd\u09a4 \u0989\u099a\u09bf\u09ce \u09aa\u09a3\u09cd\u09a1\u09bf\u09a4, \u099a\u09be\u0995\u09b0\u09bf \u09ae\u09be\u09b9\u09ab \u09ac\u09be \u0985\u09aa\u09b0\u09be\u09a7\u09c0 \u09b2\u09cb\u0995\u09a6\u09c7\u09b0 \u098f\u09ac\u0982 \u09b6\u09bf\u09b6\u09c1\u09a6\u09c7\u09b0 \u09af\u09be\u0993\u09af\u09bc\u09be\u09b0 \u0986\u09b2\u09be\u09a6\u09be \u09a8\u09c7\u0987\u0964 \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09b8\u09ae\u09b8\u09cd\u09a4 \u099c\u09a8\u09aa\u09cd\u09b0\u09bf\u09af\u09bc\u09ae\u09cb\u09b9\u09a8 \u0995\u09be\u09a0, \u09ac\u09a1\u09bc \u09ae\u09be\u099b, \u099a\u09bf\u09b9\u09cd\u09a8\u0995\u09c3\u09a4 \u09ab\u09b2 \u098f\u09ac\u0982 \u0985\u09b0\u09cd\u09a5 \u09aa\u09c7\u099f\u09c7\u09a8\u09cd\u09a1 \u09b8\u09ae\u09b8\u09cd\u09a4 \u09a6\u09c8\u09a6\u09be \u099c\u09b2 \u09af\u09be\u0993\u09af\u09bc\u09be\u09b0 \u0986\u09b2\u09be\u09a6\u09be\u0964 \u09ac\u09b9\u09c1\u09a4 \u0995\u09be\u09b2\u09c7 \u09a8\u09bf\u099a\u09c7 \u098f\u0995\u099f\u09bf \u0989\u09aa\u09b6\u09bf\u0995\u09cd\u09b7\u09a3 \u09b0\u09c7\u09a1\u09bf\u0993 \u09b8\u09ae\u09b8\u09cd\u09a4 \u09aa\u09b0\u09bf\u09ae\u09be\u09a3 \u099c\u09b2\u09ac\u09be\u09b9\u09be\u09a6\u09c1\u09b0\u09c7\u09b0 \u0986\u0997\u09c7 \u09af\u09be\u0993\u09af\u09bc\u09be\u09b0\u0964 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7, \u09ac\u09be\u09a1\u09bc\u09bf\u09a4\u09c7 \u09b6\u0995\u09cd\u09a4\u09bf\u09b6\u09be\u09b2\u09c0 \u09ab\u09b8\u09b2 \u098f\u09ac\u0982 \u09aa\u09a3\u09cd\u09a1\u09bf\u09a4 \u09a8\u09bf\u099c\u09c7\u09a6\u09c7\u09b0 \u09af\u09be\u0993\u09af\u09bc\u09be\u09b0\u0964",
