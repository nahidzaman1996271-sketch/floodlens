    {
      "building_id": "B0003",
      "risk_level": "CRITICAL",
      "message": "There is critical flooding risk (1 hour until flood). You have been assigned to Char Bandar Primary School Shelter. The shelter is 2.2 km away. Roads will be impassable in about an hour. Move children, older people, pregnant women and disabled first. Pack essential items such as ID cards, medicine, water, food, torches, phone with cash, and meet at the assigned shelter. Follow guidance from authorities for further instructions.",
      "source": "ollama_local",
      "message_bn": "\u0995\u09cd\u09b0\u09bf\u09ae\u09bf\u09a8\u09be\u09b2 \u099c\u09b2\u09ac\u09be\u09af\u09bc\u09c1\u09ae\u09a8\u09cd\u09a1\u09bf\u09b0 \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0 (CRITICAL) \u09aa\u09b0\u09bf\u09b7\u09a1\u09bc\u09bf\u09a4 \u09ac\u09be\u09b8\u09b8\u09cd\u09a5\u09be\u09a8 \u0985\u09aa\u09b0\u09be\u09a7\u09c0 \u09b6\u09bf\u0995\u09cd\u09b7\u09be \u09ae\u09b9\u09be\u0982\u09af\u09bc\u09a8\u09cd\u09a4\u09cd\u09af (Char Bandar Primary School) \u09b6\u09bf\u09b2\u09cd\u09aa\u09c7 2.2 \u0995\u09bf\u09b2\u09cb\u09ae\u09bf\u099f\u09be\u09b0 \u09a6\u09c2\u09b0\u0964 \u09b8\u09a1\u09bc\u0995\u099f\u09bf \u0986\u0997\u09c7 \u09ac\u09a8\u09cd\u09a7 \u09b9\u09ac\u09c7, \u098f\u0996\u09a8 \u09a8\u09bf\u099c\u09c7\u09a6\u09c7\u09b0 \u09ae\u09a4 \u09b6\u09bf\u09b2\u09cd\u09aa\u09c7 \u09af\u09be\u0993\u09af\u09bc\u09be \u0989\u099a\u09bf\u09a4\u0964 \u0995\u09b2\u09ae\u09c1\u09a6\u09cd\u09b0\u09be\u0997\u09c1\u09b2\u09bf, \u09b8\u09cd\u099f\u09c7\u099f \u0987\u09a1 \u09ac\u0987\u0997\u09c1\u09b2\u09bf, \u09a1\u09be\u09a8\u09b8\u09a8 \u098f\u09ac\u0982 \u09ae\u09b9\u09be\u09aa\u09b0\u09bf\u09b7\u0995\u09c7\u09b0 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u09a6\u09bf\u09af\u09bc\u09c7 \u099a\u09be\u0995\u09b0\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09c1\u09aa\u09be\u09b0\u09ad\u09be\u0987\u099c\u09a1 \u09ac\u0987\u0997\u09c1\u09b2\u09bf, \u0986\u09b0\u0993 \u098f\u0995\u099f\u09be \u09aa\u09be\u09a8\u09bf \u0993 \u0996\u09be\u09a6\u09cd\u09af \u0989\u09aa\u09af\u09cb\u0997\u09c0 \u0997\u09c1\u09b2\u09bf\u0995\u09c7 \u09b6\u09bf\u09b2\u09cd\u09aa\u09c7 \u09b8\u0982\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09a4\u09c7\u0964 \u09ac\u09a1\u09bc\u09a6\u09c7\u09b0, \u09ae\u09be\u09a4\u09be-\u09ae\u09be\u0998\u09bf\u09b0 \u098f\u09ac\u0982 \u0985\u09a8\u09cd\u09af \u0986\u09b8\u0995\u09a8\u09cd\u09a1\u09be\u0997\u09c1\u09b2\u09bf \u0989\u09aa\u09b0\u09bf\u09b8\u09cd\u09a5\u09bf\u09a4 \u09b9\u0993\u09af\u09bc\u09be \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u09b6\u09bf\u09b2\u09cd\u09aa\u09c7 \u09af\u09be\u0993\u09af\u09bc\u09be \u09a8\u09c7\u0987\u0964 \u098f\u09ae\u09a8\u0995\u09bf \u09ac\u09be\u0987\u099f \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u0993, \u0986\u09b8\u09b2\u09cb \u099c\u09b2\u09ac\u09be\u09af\u09bc\u09c1\u09ae\u09a8\u09cd\u09a1\u09bf\u09b0 \u09b8\u09ae\u09af\u09bc\u09c7 \u09b6\u09bf\u09b2\u09cd\u09aa\u09c7 \u0985\u09aa\u09b0\u09be\u09a7\u09c0 \u09a8\u09be \u09b9\u0993\u0964",
